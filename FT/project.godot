; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[admob]

general/android/enable_r8_optimization=true

[application]

config/name="F T - CREATE QR & SCANNING"
config/description="Create and scan QR codes. Fast, private, offline."
run/main_scene="res://scenes/Main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60
run/delta_smoothing=false
config/icon="res://assets/icon.png"

[autoload]

GameState="*res://autoload/GameState.gd"
I18n="*res://autoload/I18n.gd"
AdController="*res://autoload/AdController.gd"

[display]

window/size/viewport_width=432
window/size/viewport_height=936
window/energy_saving/keep_screen_on=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg")

[gui]

theme/default_font_antialiasing=2
common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

rendering/force_native_scroll_latin_digits=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.875, 0.957, 1, 1)
